# Copy this file to .env and fill in your Supabase project values.
# Find these under Project Settings -> API in your Supabase dashboard.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push public key. Generate a VAPID key pair with:
#   npx web-push generate-vapid-keys
# Put the PUBLIC key here. Put the PRIVATE key (and this same public key)
# as Supabase function secrets - see supabase/functions/README.md - never
# in this file or anywhere shipped to the browser.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
